// Matrix multiplication 400x400
// Equivalent to matrix_mult.py

Размер = 400;

// Создать матрицу с функцией инициализации
Функция СоздатьМатрицу(Размер, Знач ТипЗначения = "Сумма")
    Матрица = Новый Массив(Размер);
    Для i = 0 По Размер - 1 Цикл
        Строка = Новый Массив(Размер);
        Для j = 0 По Размер - 1 Цикл
            Если ТипЗначения = "Сумма" Тогда
                // A[i][j] = i + j + 1
                Значение = i + j + 1;
            ИначеЕсли ТипЗначения = "Разность" Тогда
                // B[i][j] = i - j + 1
                Значение = i - j + 1;
            Иначе
                Значение = 1;
            КонецЕсли;
            Строка.Добавить(Значение);
        КонецЦикла;
        Матрица[i] = Строка;
    КонецЦикла;
    Возврат Матрица;
КонецФункции

// Умножение двух матриц
Функция УмножитьМатрицы(А, В, Размер)
    // Инициализировать результат нулями
    С = Новый Массив(Размер);
    Для i = 0 По Размер - 1 Цикл
        СтрокаРез = Новый Массив(Размер);
        Для j = 0 По Размер - 1 Цикл
            СтрокаРез.Добавить(0);
        КонецЦикла;
        С[i] = СтрокаРез;
    КонецЦикла;
    
    // Стандартное O(n³) умножение матриц
    Для i = 0 По Размер - 1 Цикл
        Для j = 0 По Размер - 1 Цикл
            Сумма = 0;
            Для k = 0 По Размер - 1 Цикл
                Сумма = Сумма + А[i][k] * В[k][j];
            КонецЦикла;
            С[i][j] = Сумма;
        КонецЦикла;
    КонецЦикла;
    
    Возврат С;
КонецФункции

// Вывод части матрицы (первые 5x5)
Процедура ВывестиМатрицу(Матрица, Размер, Префикс = "")
    МаксСтрока = Мин(5, Размер);
    МаксКол = Мин(5, Размер);
    Для i = 0 По МаксСтрока - 1 Цикл
        СтрокаТекст = "";
        Для j = 0 По МаксКол - 1 Цикл
            СтрокаТекст = СтрокаТекст + Формат(Матрица[i][j], "ЧГ=10.2") + " ";
        КонецЦикла;
        Сообщить(Префикс + "[" + Строка(i) + "]: " + СтрокаТекст);
    КонецЦикла;
КонецПроцедуры

// Основная программа
Сообщить("Умножение матриц " + Строка(Размер) + "x" + Строка(Размер));
Сообщить("Инициализация матриц...");

// Матрица A: A[i][j] = i + j + 1
А = СоздатьМатрицу(Размер, "Сумма");

// Матрица B: B[i][j] = i - j + 1
В = СоздатьМатрицу(Размер, "Разность");

Сообщить("Умножение матриц...");
С = УмножитьМатрицы(А, В, Размер);

Сообщить("Результат (первые 5x5):");
ВывестиМатрицу(С, Размер, "  ");

Сообщить("Всего элементов: " + Строка(Размер * Размер));
Сообщить("Готово!");
