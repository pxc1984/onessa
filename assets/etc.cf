// Модуль объекта "Обработка.УправлениеПерсоналом"

Перем Компания; // Глобальная переменная уровня модуля
Перем ТекущийПользователь Экспорт; // Экспортируемая переменная

// Конструктор - инициализация при создании объекта
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Компания = "ООО Ромашка";
    ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
    // Вызов исключения при необходимости
    Если Компания = Неопределено Тогда
        ВызватьИсключение "Не удалось определить компанию!";
    КонецЕсли;
КонецПроцедуры

// Функция с множественными возвращаемыми значениями через структуру
Функция РассчитатьЗарплату(Сотрудник, Период) Экспорт

    // Локальные переменные
    Перем Оклад, Премия, Налоги, ИтогоКВыплате;
    Перем РезультатРасчета;

    // Попытка выполнения с обработкой ошибок
    Попытка

        // Запрос к базе данных
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |   Сотрудники.Оклад КАК Оклад,
        |   Сотрудники.СтавкаНалога КАК Налог,
        |   Сотрудники.Отдел КАК Отдел
        |ИЗ
        |   Справочник.Сотрудники КАК Сотрудники
        |ГДЕ
        |   Сотрудники.Ссылка = &Ссылка";

        Запрос.УстановитьПараметр("Ссылка", Сотрудник);
        Результат = Запрос.Выполнить();

        Если Результат.Пустой() Тогда
            Возврат Новый Структура("Ошибка", Истина, "Сотрудник не найден");
        КонецЕсли;

        Выборка = Результат.Выбрать();
        Выборка.Следующий();

        Оклад = Выборка.Оклад;

        // Множественный выбор
        Премия = ?(Выборка.Отдел = "Продажи", Оклад * 0.3, Оклад * 0.1);

        // Цикл по коллекции
        Для Каждого День Из Период Цикл
            // Обработка каждого дня
            ;
        КонецЦикла;

        // Работа с таблицей значений
        ТаблицаНачислений = Новый ТаблицаЗначений;
        ТаблицаНачислений.Колонки.Добавить("Вид", Новый ОписаниеТипов("Строка"));
        ТаблицаНачислений.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
        ТаблицаНачислений.Колонки.Добавить("Процент", Новый ОписаниеТипов("Число"));

        // Заполнение таблицы
        Строка = ТаблицаНачислений.Добавить();
        Строка.Вид = "Оклад";
        Строка.Сумма = Оклад;

        Строка = ТаблицаНачислений.Добавить();
        Строка.Вид = "Премия";
        Строка.Сумма = Премия;

        // Сортировка таблицы
        ТаблицаНачислений.Сортировать("Сумма Убыв");

        // Работа с массивом
        МассивНалогов = Новый Массив;
        МассивНалогов.Добавить(0.13); // НДФЛ
        МассивНалогов.Добавить(0.22); // ПФР
        МассивНалогов.Добавить(0.051); // ФОМС

        // Вычисление налогов
        Налоги = 0;
        Для Индекс = 0 По МассивНалогов.ВГраница() Цикл
            Налоги = Налоги + (Оклад + Премия) * МассивНалогов[Индекс];
        КонецЦикла;

        // Итоговый расчет
        ИтогоКВыплате = Оклад + Премия - Налоги;

        // Создание структуры результата
        РезультатРасчета = Новый Структура;
        РезультатРасчета.Вставить("Успешно", Истина);
        РезультатРасчета.Вставить("Оклад", Оклад);
        РезультатРасчета.Вставить("Премия", Премия);
        РезультатРасчета.Вставить("Налоги", Налоги);
        РезультатРасчета.Вставить("ИтогоКВыплате", ИтогоКВыплате);
        РезультатРасчета.Вставить("ТаблицаНачислений", ТаблицаНачислений);

        // Запись в регистр сведений
        Движение = РегистрыСведений.РасчетыЗарплаты.СоздатьМенеджерЗаписи();
        Движение.Сотрудник = Сотрудник;
        Движение.Период = ТекущаяДатаСеанса();
        Движение.Сумма = ИтогоКВыплате;
        Движение.Записать();

        Возврат РезультатРасчета;

    Исключение
        // Обработка ошибки
        ТекстОшибки = ОписаниеОшибки();
        ЗаписьЖурналаРегистрации("ОшибкаРасчета", УровеньЖурналаРегистрации.Ошибка,,,
            "Ошибка при расчете зарплаты: " + ТекстОшибки);
        Возврат Новый Структура("Успешно, ТекстОшибки", Ложь, ТекстОшибки);
    КонецПопытки;

КонецФункции

// Процедура с необязательными параметрами и передачей по ссылке
Процедура СформироватьОтчет(Период, ВыводитьДетализацию = Ложь, ТаблицаРезультат = Неопределено) Экспорт

    // Проверка типов
    Если ТипЗнч(Период) <> Тип("СтандартныйПериод") Тогда
        Период = ТекущийСтандартныйПериод(); // Значение по умолчанию
    КонецЕсли;

    // Создание временной таблицы в запросе
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   &ДатаНачала КАК ДатаНачала,
    |   &ДатаОкончания КАК ДатаОкончания
    |ПОМЕСТИТЬ ВТ_Параметры";

    Запрос.УстановитьПараметр("ДатаНачала", Период.ДатаНачала);
    Запрос.УстановитьПараметр("ДатаОкончания", Период.ДатаОкончания);
    Запрос.Выполнить();

    // Основной запрос
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Сотрудники.Код КАК КодСотрудника,
    |   Сотрудники.Наименование КАК ФИО,
    |   СУММА(Начисления.Сумма) КАК ИтогоНачислено,
    |   КОЛИЧЕСТВО(Начисления.Период) КАК КоличествоНачислений
    |ИЗ
    |   Справочник.Сотрудники КАК Сотрудники
    |       ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Начисления КАК Начисления
    |       ПО Сотрудники.Ссылка = Начисления.Сотрудник
    |           И Начисления.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
    |ГДЕ
    |   Сотрудники.ПометкаУдаления = ЛОЖЬ
    |
    |СГРУППИРОВАТЬ ПО
    |   Сотрудники.Код,
    |   Сотрудники.Наименование
    |
    |ИТОГИ ПО
    |   ОБЩИЕ";

    Результат = Запрос.Выполнить();

    // Проверка заполнения ссылочного параметра
    Если ТаблицаРезультат = Неопределено Тогда
        ТаблицаРезультат = Новый ТаблицаЗначений;
    КонецЕсли;

    // Выгрузка результата в таблицу
    Результат.Выгрузить(ТаблицаРезультат);

    // Условный оператор в одну строку
    Сообщение = ?(ТаблицаРезультат.Количество() = 0, "Нет данных", "Отчет сформирован");

    // Вывод сообщения пользователю
    Если ВыводитьДетализацию Тогда
        Для Каждого СтрокаТаблицы Из ТаблицаРезультат Цикл
            Сообщить(СтрокаТаблицы.ФИО + ": " + СтрокаТаблицы.ИтогоНачислено);
        КонецЦикла;
    КонецЕсли;

КонецПроцедуры

// Функция с рекурсией
Функция ПолучитьРуководителя(Сотрудник, Уровень = 0, МаксимальнаяГлубина = 10) Экспорт

    Если Уровень >= МаксимальнаяГлубина Тогда
        Возврат Неопределено; // Предотвращение бесконечной рекурсии
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Сотрудники.Руководитель КАК Руководитель
    |ИЗ
    |   Справочник.Сотрудники КАК Сотрудники
    |ГДЕ
    |   Сотрудники.Ссылка = &Ссылка";

    Запрос.УстановитьПараметр("Ссылка", Сотрудник);
    Результат = Запрос.Выполнить();

    Если Результат.Пустой() Тогда
        Возврат Неопределено;
    КонецЕсли;

    Выборка = Результат.Выбрать();
    Выборка.Следующий();
    Руководитель = Выборка.Руководитель;

    Если Руководитель = Неопределено ИЛИ Руководитель.Пустая() Тогда
        Возврат Сотрудник; // Найден высший руководитель
    Иначе
        // Рекурсивный вызов
        Возврат ПолучитьРуководителя(Руководитель, Уровень + 1, МаксимальнаяГлубина);
    КонецЕсли;

КонецФункции

// Процедура с обработкой транзакции
Процедура ПровестиДокумент(ДокументСсылка) Экспорт

    // Начало транзакции
    НачатьТранзакцию();

    Попытка

        // Блокировка данных
        ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
        ДокументОбъект.Заблокировать();

        // Проверка проведения
        Если ДокументОбъект.Проведен Тогда
            ВызватьИсключение "Документ уже проведен!";
        КонецЕсли;

        // Формирование движений
        ДокументОбъект.Движения.РегистрНакопления.Товары.Записывать = Истина;

        Для Каждого Товар Из ДокументОбъект.Товары Цикл
            Движение = ДокументОбъект.Движения.РегистрНакопления.Товары.Добавить();
            Движение.Период = ДокументОбъект.Дата;
            Движение.Товар = Товар.Номенклатура;
            Движение.Количество = Товар.Количество;
            Движение.Сумма = Товар.Сумма;
            Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
        КонецЦикла;

        // Запись движений
        ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);

        // Фиксация транзакции
        ЗафиксироватьТранзакцию();

    Исключение
        // Откат транзакции при ошибке
        ОтменитьТранзакцию();

        // Генерация события для внешней обработки
        ВызватьИсключение "Ошибка проведения: " + ОписаниеОшибки();
    КонецПопытки;

КонецПроцедуры

// Обработчик команд формы
Процедура РассчитатьИтоги(Команда)

    Перем Результат;

    // Получение данных из формы
    Сотрудник = РеквизитФормыВЗначение("Объект.Сотрудник");
    Период = РеквизитФормыВЗначение("Объект.Период");

    // Вызов серверной функции
    Результат = РассчитатьЗарплату(Сотрудник, Период);

    // Проверка результата
    Если Результат.Успешно Тогда

        // Заполнение реквизитов формы
        ЗначениеВРеквизитФормы(Результат.Оклад, "Объект.Оклад");
        ЗначениеВРеквизитФормы(Результат.Премия, "Объект.Премия");
        ЗначениеВРеквизитФормы(Результат.ИтогоКВыплате, "Объект.Итого");

        // Обновление табличной части
        ТабличнаяЧасть = ЭлементыФормы.Начисления;
        ТабличнаяЧасть.Очистить();

        Для Каждого Строка Из Результат.ТаблицаНачислений Цикл
            НоваяСтрока = Объект.Начисления.Добавить();
            НоваяСтрока.Вид = Строка.Вид;
            НоваяСтрока.Сумма = Строка.Сумма;
        КонецЦикла;

        // Предупреждение пользователя
        Предупреждение("Расчет выполнен успешно!", 5);

    Иначе
        // Сообщение об ошибке
        Сообщить("Ошибка: " + Результат.ТекстОшибки, СтатусСообщения.ОченьВажное);
    КонецЕсли;

КонецПроцедуры
