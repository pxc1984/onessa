функция Фибоначчи(Знач н)
    если н < 1 тогда
        возврат 0;
    конецесли;
    если н = 1 тогда
        возврат 1;
    конецесли;

    а = 0;
    б = 1;
    для i = 2 по н + 1 цикл
        временнаяА = а;
        а = б;
        б = временнаяА + б;
    конеццикла

    возврат б;
конецфункции

Сч = 10;
Для Сч = 1 По 1000 Цикл
    Сообщить("Фибоначчи(" + Сч + ") = " + Фибоначчи(Сч));
конеццикла;
