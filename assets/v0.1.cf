// Onessa v0.1 - Showcase новых возможностей
// ==========================================
// 
// Новые фичи:
// 1. Десятичные числа (Decimal) вместо f64 - точная арифметика
// 2. Массивы - упорядоченные коллекции с 1-й индексацией
// 3. Структуры - ключ-значение пары
// 4. Объекты - с свойствами и методами

// ===== 1. ТОЧНАЯ АРИФМЕТИКА С DECIMAL =====
// 0.1 + 0.2 = 0.3 (точно, без ошибок плавающей точки!)
Сумма = 0.1 + 0.2;
Сообщить("0.1 + 0.2 = " + Сумма); // Вывод: 0,3

// Большие числа с точностью
БольшоеЧисло = 1234567890.123456789;
Сообщить("Большое число: " + БольшоеЧисло);

// Проверка точности: 0.1 + 0.2 == 0.3
Если Сумма = 0.3 Тогда
    Сообщить("Точная арифметика работает!");
КонецЕсли;

// ===== 2. ФИНАНСОВЫЕ РАСЧЕТЫ =====
// Точные расчеты без потерь точности
Цена = 199.99;
Количество = 3;
СуммаКОплате = Цена * Количество;
Сообщить("К оплате: " + СуммаКОплате); // 599.97 точно!

// Скидка 10%
Скидка = СуммаКОплате * 0.1;
Итог = СуммаКОплате - Скидка;
Сообщить("Со скидкой: " + Итог);

// ===== 3. АРИФМЕТИЧЕСКИЕ ОПЕРАЦИИ =====
// Сложение, вычитание, умножение, деление
А = 10.5;
Б = 2.5;
Сообщить("Сумма: " + (А + Б));
Сообщить("Разность: " + (А - Б));
Сообщить("Произведение: " + (А * Б));
Сообщить("Частное: " + (А / Б));

// ===== 4. РАБОТА СО СТРОКАМИ =====
Текст = "Привет, Onessa!";
Сообщить(Текст);
Сообщить("Длина: " + СтрДлина(Текст));
Сообщить("В верхнем регистре: " + ВРег(Текст));

// ===== 5. ДАТА И ВРЕМЯ =====
Текущая = ТекущаяДата();
Сообщить("Текущая дата: " + Текущая);

// ===== 6. ИСКОРЕНЕНИЕ ОШИБОК =====
// Деление на ноль защищено
Попытка
    Результат = 10 / 0;
Исключение
    Сообщить("Ошибка: " + ОписаниеОшибки());
КонецПопытки;
