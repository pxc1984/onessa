// Заполнение массива методами и сортировка вставками
М = Новый Массив;
Для i = 0 По 2999 Цикл
    М.Добавить((i * 7919) % 3001);
КонецЦикла;
Для i = 1 По М.ВГраница() Цикл
    Ключ = М[i];
    j = i - 1;
    Пока j >= 0 И М[j] > Ключ Цикл
        М[j + 1] = М[j];
        j = j - 1;
    КонецЦикла;
    М[j + 1] = Ключ;
КонецЦикла;
Сообщить(Строка(М[0]) + " " + М[1500] + " " + М[2999] + " " + М.Количество());
