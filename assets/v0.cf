// Пример программы, которую поддерживает v0: onessa run assets/v0.cf

Перем ВсегоВызовов;

Функция Фибоначчи(Знач Н)
    ВсегоВызовов = ВсегоВызовов + 1;
    Если Н < 2 Тогда
        Возврат Н;
    КонецЕсли;
    Возврат Фибоначчи(Н - 1) + Фибоначчи(Н - 2);
КонецФункции

Процедура Обменять(А, Б)
    Временная = А;
    А = Б;
    Б = Временная;
КонецПроцедуры

Функция Поделить(Делимое, Делитель)
    Попытка
        Возврат Делимое / Делитель;
    Исключение
        Сообщить("Не удалось поделить: " + ОписаниеОшибки());
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

ВсегоВызовов = 0;
Для Сч = 0 По 10 Цикл
    Сообщить("Фибоначчи(" + Сч + ") = " + Фибоначчи(Сч));
КонецЦикла;
Сообщить("Всего вызовов: " + ВсегоВызовов);

Х = "первый";
У = "второй";
Обменять(Х, У);
Сообщить(Х + ", " + У);

Сообщить(Поделить(10, 4));
Поделить(1, 0);

Сообщить(?(ЗначениеЗаполнено('20240101'), "дата заполнена", "пустая дата"));
